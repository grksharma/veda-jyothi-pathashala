# Copy to .env and fill in. Never commit .env.

# Public subdomain for n8n (must match the Caddyfile)
N8N_HOST=n8n.example.com

# Editor login
N8N_USER=admin
N8N_PASSWORD=change-this-to-something-long

# Where enquiries are delivered, international format, no + or spaces
VJP_WHATSAPP_TO=919032644115

# From Meta: WhatsApp > API Setup > "Phone number ID" (a long number, not the phone number)
VJP_WA_PHONE_NUMBER_ID=
